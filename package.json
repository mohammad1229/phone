{
  "name": "mobile-shop-erp",
  "version": "1.1.0",
  "description": "نظام إدارة محلات الهواتف المتكامل",
  "main": "main.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.gonetphone.pos",
    "productName": "gonet phone",
    "publish": [
      {
        "provider": "github",
        "owner": "mohammad1229",
        "repo": "phone"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "asarUnpack": [
      "**/*.sqlite"
    ],
    "extraResources": [
      {
        "from": "node_modules/better-sqlite3",
        "to": "app/node_modules/better-sqlite3"
      }
    ]
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsbarcode": "^3.11.6",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "latest",
    "nodemon": "^3.0.2"
  }
}
